#!/usr/bin/env bash
set -euo pipefail

source /usr/lib/sendspin-cli/common.sh
source /usr/lib/sendspin-cli/players.sh

# s6-svscan passes the service directory name, which is the validated zone id.
sendspin::player_paths "$1"

# A missing card is expected during hotplug; the native CLI needs its sink at startup.
if jq -e --arg id "$1" '.[] | select(.id == $id) | has("device")' "${SENDSPIN_SELECTORS_FILE}" > /dev/null; then
    trap 'exit 0' TERM INT
    until jq -e --arg id "$1" '.ready | index($id) != null' "${SENDSPIN_RUN_DIR}/routes.json" > /dev/null 2>&1; do
        sleep 1
    done
fi

# Avahi supports silencing the linkage notice for Bonjour-based clients.
AVAHI_COMPAT_NOWARN=1 exec sendspin-cli \
    --config "${player_conf}" \
    --state-dir "${player_state_dir}" \
    --control-socket "${player_control_socket}"
