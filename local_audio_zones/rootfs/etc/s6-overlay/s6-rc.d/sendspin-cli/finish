#!/command/with-contenv bash

# Invalid startup configuration stops the container. Once zones are running,
# their own s6 supervisors recover individual players without stopping others.
exit_code=$1
if [ "$exit_code" -eq 256 ]; then
    # SIGTERM is an orderly stop. Other signals can leave scanner children alive.
    [ "$2" -ne 15 ] || exit 0
    exit_code=$((128 + $2))
fi

if [ "$exit_code" -ne 0 ]; then
    echo "sendspin-cli exited ${exit_code}; stopping the container." >&2
    echo "$exit_code" > /run/s6-linux-init-container-results/exitcode
    exec /run/s6/basedir/bin/halt
fi
